root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf

# Pawn-код из старых сборок может быть в Windows-1251.
# Не перекодировать .pwn/.inc автоматически без проверки.
