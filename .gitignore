# Ключи, созданные для конкретного сервера (никогда не хранить в Git)
**/private/install.key
**/private/app.key
# Рабочие хранилища учётных записей, сообщений и статей
Форум/private/store.json
Вики/private/data.json
# Файлы пользователей
Форум/public/uploads/
Вики/public/uploads/
# Тесты, логи, сборки
*.log
*.tmp
*.bak
__pycache__/
*.pyc
# Скомпилированные файлы и локальная конфигурация сервера
Мод/gamemodes/*.amx
Мод/scriptfiles/serverconfig.ini
Мод/plugins/*.dll
Мод/plugins/*.so
Мод/*.exe
